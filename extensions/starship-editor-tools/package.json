{
  "package_version": 2,
  "version": "1.5.0",
  "name": "starship-editor-tools",
  "description": "i18n:starship-editor-tools.description",
  "main": "./dist/main.js",
  "author": "Starship Protocol",
  "editor": ">=3.8.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.7",
    "@types/node": "^18.18.13",
    "typescript": "5.8.2"
  },
  "panels": {
    "default": {
      "title": "星舰协议 - 新建房间建筑",
      "type": "simple",
      "main": "./dist/panels/room-create",
      "size": {
        "min-width": 520,
        "min-height": 680,
        "width": 600,
        "height": 760
      }
    },
    "authoring": {
      "title": "星舰创作工具",
      "type": "dockable",
      "main": "./dist/panels/authoring-panel",
      "size": {
        "min-width": 420,
        "min-height": 420,
        "width": 920,
        "height": 680
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.project",
        "label": "i18n:starship-editor-tools.open_authoring",
        "message": "open-authoring-panel"
      },
      {
        "path": "i18n:menu.panel",
        "label": "i18n:starship-editor-tools.open_authoring",
        "message": "open-authoring-panel"
      }
    ],
    "assets": {
      "menu": {
        "methods": "./dist/assets-menu.js",
        "createMenu": "onCreateMenu"
      }
    },
    "messages": {
      "open-room-create": {
        "methods": ["openRoomCreate"]
      },
      "create-room-content": {
        "methods": ["createRoomContent"]
      },
      "create-crew-content": {
        "methods": ["createCrewContent"]
      },
      "open-created-prefab": {
        "methods": ["openCreatedPrefab"]
      },
      "validate-open-room-prefab": {
        "methods": ["validateOpenRoomPrefab"]
      },
      "open-authoring-panel": {
        "methods": ["openAuthoringPanel"]
      },
      "get-authoring-state": {
        "methods": ["getAuthoringState"]
      },
      "refresh-authoring-state": {
        "methods": ["refreshAuthoringState"]
      },
      "create-room-instance": {
        "methods": ["createRoomInstance"]
      },
      "create-crew-instance": {
        "methods": ["createCrewInstance"]
      },
      "update-room-definition": {
        "methods": ["updateRoomDefinition"]
      },
      "update-crew-definition": {
        "methods": ["updateCrewDefinition"]
      },
      "create-hull-definition": {
        "methods": ["createHullDefinition"]
      },
      "update-hull-definition": {
        "methods": ["updateHullDefinition"]
      },
      "create-ship-instance": {
        "methods": ["createShipInstance"]
      },
      "initialize-scene-skeleton": {
        "methods": ["initializeSceneSkeleton"]
      },
      "create-foundation-prefabs": {
        "methods": ["createFoundationPrefabs"]
      },
      "mount-shared-ui": {
        "methods": ["mountSharedUi"]
      },
      "wire-scene-foundation": {
        "methods": ["wireSceneFoundation"]
      }
    }
  }
}
