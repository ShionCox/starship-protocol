{
  "package_version": 2,
  "version": "2.0.0",
  "name": "starship-editor-tools",
  "description": "i18n:starship-editor-tools.description",
  "main": "./dist/extension-bootstrap.js",
  "author": "Starship Protocol",
  "editor": ">=3.8.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.7",
    "@types/node": "^18.18.13",
    "typescript": "5.8.2"
  },
  "panels": {
    "authoring": {
      "title": "星舰创作工具",
      "type": "dockable",
      "main": "./dist/panels/authoring-panel",
      "size": {
        "min-width": 420,
        "min-height": 420,
        "width": 920,
        "height": 680
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.project",
        "label": "i18n:starship-editor-tools.open_authoring",
        "message": "open-authoring-panel"
      },
      {
        "path": "i18n:menu.panel",
        "label": "i18n:starship-editor-tools.open_authoring",
        "message": "open-authoring-panel"
      }
    ],
    "assets": {
      "menu": {
        "methods": "./dist/assets-menu.js",
        "createMenu": "onCreateMenu"
      }
    },
    "messages": {
      "open-created-prefab": {
        "methods": ["openCreatedPrefab"]
      },
      "open-authoring-panel": {
        "methods": ["openAuthoringPanel"]
      },
      "get-authoring-state": {
        "methods": ["getAuthoringState"]
      },
      "refresh-authoring-state": {
        "methods": ["refreshAuthoringState"]
      },
      "create-room-instance": {
        "methods": ["createRoomInstance"]
      },
      "create-crew-instance": {
        "methods": ["createCrewInstance"]
      },
      "build-pss-index": {
        "methods": ["buildPssIndex"]
      },
      "search-pss-assets": {
        "methods": ["searchPssAssets"]
      },
      "bind-first-pss-room-appearances": {
        "methods": ["bindFirstPssRoomAppearances"]
      },
      "bind-first-pss-crew-appearances": {
        "methods": ["bindFirstPssCrewAppearances"]
      },
      "import-and-bind-first-pss-hull-appearances": {
        "methods": ["importAndBindFirstPssHullAppearances"]
      },
      "get-csv-config-tables": {
        "methods": ["getCsvConfigTables"]
      },
      "import-csv-config-bundle": {
        "methods": ["importCsvConfigBundle"]
      },
      "get-room-csv-drafts": {
        "methods": ["getRoomCsvDrafts"]
      },
      "create-room-csv-draft": {
        "methods": ["createRoomCsvDraft"]
      },
      "create-crew-csv-draft": {
        "methods": ["createCrewCsvDraft"]
      },
      "create-hull-csv-draft": {
        "methods": ["createHullCsvDraft"]
      },
      "preview-room-definition": {
        "methods": ["previewRoomDefinition"]
      },
      "cancel-authoring-preview": {
        "methods": ["cancelAuthoringPreview"]
      },
      "save-room-csv-draft": {
        "methods": ["saveRoomCsvDraft"]
      },
      "save-crew-csv-draft": {
        "methods": ["saveCrewCsvDraft"]
      },
      "preview-crew-definition": {
        "methods": ["previewCrewDefinition"]
      },
      "save-hull-csv-draft": {
        "methods": ["saveHullCsvDraft"]
      },
      "preview-hull-definition": {
        "methods": ["previewHullDefinition"]
      },
      "update-room-instance": {
        "methods": ["updateRoomInstance"]
      },
      "create-ship-instance": {
        "methods": ["createShipInstance"]
      },
      "create-or-update-scene": {
        "methods": ["createOrUpdateScene"]
      }
    }
  }
}
